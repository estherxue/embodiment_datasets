{
  "type": "act",
  "n_obs_steps": 1,
  "normalization_mapping": {
    "ENV": "MIN_MAX",
    "STATE": "MIN_MAX",
    "ACTION": "MIN_MAX"
  },
  "input_features": {
    "observation.environment_state": {
      "type": "ENV",
      "shape": [
        16
      ]
    },
    "observation.state": {
      "type": "STATE",
      "shape": [
        2
      ]
    }
  },
  "output_features": {
    "action": {
      "type": "ACTION",
      "shape": [
        2
      ]
    }
  },
  "device": "cpu",
  "use_amp": false,
  "chunk_size": 16,
  "n_action_steps": 16,
  "vision_backbone": "resnet18",
  "pretrained_backbone_weights": "ResNet18_Weights.IMAGENET1K_V1",
  "replace_final_stride_with_dilation": false,
  "pre_norm": false,
  "dim_model": 512,
  "n_heads": 8,
  "dim_feedforward": 3200,
  "feedforward_activation": "relu",
  "n_encoder_layers": 4,
  "n_decoder_layers": 4,
  "use_vae": true,
  "latent_dim": 32,
  "n_vae_encoder_layers": 4,
  "dropout": 0.1,
  "kl_weight": 10.0,
  "temporal_ensemble_coeff": null
}